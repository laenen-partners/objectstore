ADDR=:3000
OBJECT_STORE=file
OBJECT_STORE_PATH=.data/objects
OBJECT_STORE_URL=http://localhost:3000

# API authentication (comma-separated keys)
API_KEYS=

# Rate limiting (per IP)
RATE_LIMIT=10
RATE_BURST=20

# S3 backend (uncomment to use)
# OBJECT_STORE=s3
# S3_REGION=eu-west-1
# S3_ENDPOINT=http://localhost:9000

# CORS (comma-separated origins, empty = disabled)
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Max presigned URL lifetime in seconds (0 = no cap)
# MAX_EXPIRES_SECONDS=3600

# Postgres token store (docker compose up to start)
# WARNING: Change credentials before any non-local deployment.
OBJECT_STORE_POSTGRES_URL=postgres://objectstore:objectstore@localhost:5432/objectstore?sslmode=disable
